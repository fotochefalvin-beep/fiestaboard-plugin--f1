# Copy to .env (gitignored) and fill in: cp .env.example .env
# Used by docker-compose.sidecar.yml. Secrets do NOT go here: they live as
# files in secrets/ (see secrets/*.example and the README).
# Write values without quotes or spaces around them.

# --- FiestaBoard --------------------------------------------------------------
# Through FiestaBoard's nginx on the compose network: its backend binds
# 127.0.0.1:8000 inside its own container and is not reachable directly.
FIESTABOARD_RECEIVE_URL=http://fiestaboard:3000/api/v1/plugins/f1/receive
# FiestaBoard's compose network (docker network ls). Used by compose for the
# network name; harmless inside the container.
FIESTABOARD_NETWORK=fiestaboard_default

# --- Optional -----------------------------------------------------------------
# JOLPICA_URL=https://api.jolpi.ca/ergast/f1
# LOG_LEVEL=INFO
